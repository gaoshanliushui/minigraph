# examples/03_real_llm_agent.py 的配置模板。复制后填写：
#   cp .env.example .env
# .env 已在 .gitignore 里，不会被提交。
# 环境变量优先级高于本文件（load_dotenv 不覆盖已有环境变量）。

# 选 provider：anthropic | minimax | volcengine（火山引擎·方舟）| deepseek
LLM_PROVIDER=minimax

# ---- Anthropic 官方（默认模型 claude-fable-5-2）----
ANTHROPIC_API_KEY=

# ---- MiniMax（Anthropic 兼容端点）----
# 默认 base_url = https://api.minimaxi.com/anthropic（国际站 api.minimax.io/anthropic）
# 默认模型 = MiniMax-M2
MINIMAX_API_KEY=

# ---- 火山引擎·方舟（Anthropic 兼容端点）----
# 默认 base_url = https://ark.cn-beijing.volces.com/api/anthropic
# 默认模型 = doubao-seed-1-6-250615，也可用 LLM_MODEL 填推理接入点 ep-xxx
ARK_API_KEY=

# ---- DeepSeek（Anthropic 兼容端点）----
# 默认 base_url = https://api.deepseek.com/anthropic
# 默认模型 = deepseek-flash
DEEPSEEK_API_KEY=

# ---- 通用覆盖（可选，优先级最高；换端点/换模型不用改代码）----
# 默认端点和模型名以各厂商文档为准，如有出入直接在这里改：
#LLM_API_KEY=
#LLM_BASE_URL=https://api.minimaxi.com/anthropic
#LLM_MODEL=MiniMax-M2
# 认证头：bearer = Authorization: Bearer（minimax/volcengine/deepseek 默认）；
#         x-api-key = x-api-key 头（anthropic 默认）
#LLM_AUTH=bearer
